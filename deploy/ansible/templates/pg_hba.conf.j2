# PostgreSQL Client Authentication Configuration
# Generated by Ansible

# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections
local   all             postgres                                peer
local   all             all                                     peer

# IPv4 local connections
host    all             all             127.0.0.1/32            scram-sha-256

# IPv6 local connections
host    all             all             ::1/128                 scram-sha-256

# Replication connections from other registry nodes
{% for host in groups['registry'] %}
{% if hostvars[host]['ansible_host'] != ansible_host %}
host    replication     replicator      {{ hostvars[host]['ansible_host'] }}/32    scram-sha-256
host    {{ db_name }}   {{ db_user }}   {{ hostvars[host]['ansible_host'] }}/32    scram-sha-256
{% endif %}
{% endfor %}
