# CIRISRegistry Environment Configuration
# Generated by Ansible - Do not edit manually

# Environment
ENVIRONMENT={{ env }}
DEBUG={{ api_debug | default(false) | lower }}

# API
API_HOST={{ api_host }}
API_PORT={{ api_port }}
API_WORKERS={{ api_workers }}

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@localhost:{{ db_port }}/{{ db_name }}
DB_POOL_SIZE={{ db_pool_size | default(10) }}
DB_MAX_OVERFLOW={{ db_max_overflow | default(5) }}

# Signing Keys
SIGNING_KEY_ED25519={{ app_dir }}/{{ signing_key_ed25519 }}
SIGNING_KEY_MLDSA65={{ app_dir }}/{{ signing_key_mldsa65 }}

# Logging
LOG_LEVEL={{ log_level }}
LOG_DIR={{ log_dir }}

# Rate Limiting
RATE_LIMIT_AGENT={{ rate_limit_agent_lookup | default(100) }}
RATE_LIMIT_PARTNER={{ rate_limit_partner_lookup | default(60) }}
RATE_LIMIT_REVOCATION={{ rate_limit_revocation_list | default(10) }}

# Cache
CACHE_TTL_AGENT={{ cache_ttl_agent | default(300) }}
CACHE_TTL_PARTNER={{ cache_ttl_partner | default(300) }}
CACHE_TTL_REVOCATION={{ cache_ttl_revocation | default(60) }}

# Validation
VALIDATION_QUORUM={{ validation_quorum | default(2) }}
OFFLINE_GRACE_HOURS={{ offline_grace_hours | default(72) }}

# Region
REGION={{ region }}
DB_ROLE={{ db_role }}
