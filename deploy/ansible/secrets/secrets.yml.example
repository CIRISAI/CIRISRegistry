---
# CIRISRegistry Secrets
#
# Copy to secrets.yml and fill in values.
# NEVER commit secrets.yml to git!
#
# For CIRISBridge integration, pull from Vault:
#   ansible-playbook playbook.yml --extra-vars "@<(vault kv get -format=yaml secret/cirisregistry)"

# Database
db_password: "your-database-password"
db_replication_password: "your-replication-password"

# Registry Signing Keys (base64 encoded)
# Generate Ed25519: openssl genpkey -algorithm ED25519 -out ed25519.pem && base64 -w0 ed25519.pem
registry_signing_key: "base64-encoded-ed25519-private-key"
registry_signing_key_pq: "base64-encoded-mldsa65-private-key"

# API Keys
admin_api_key: "your-admin-api-key"

# Cloudflare (for DNS TXT updates)
cloudflare_api_token: "your-cloudflare-api-token"
cloudflare_zone_id: "your-zone-id"
