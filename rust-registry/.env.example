# CIRISRegistry Rust - Environment Configuration
# Copy this file to .env and customize for your environment
# WARNING: Never commit .env files with real secrets to version control

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
# Options: development, staging, canary, production

# =============================================================================
# Server Configuration
# =============================================================================
GRPC_PORT=50051
HTTP_PORT=8080
# Set HTTP_PORT=0 to disable the HTTP health/metrics endpoint

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=ciris
DB_PASSWORD=ciris_dev
# IMPORTANT: Change DB_PASSWORD in production! "ciris_dev" is blocked in production.
DB_NAME=ciris_registry
DB_SSLMODE=disable
# Options: disable, require, verify-ca, verify-full
# Production default: require (encrypted connection)
# Development default: disable (unencrypted for local dev)
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1

# =============================================================================
# Authentication Configuration
# =============================================================================
JWT_SECRET=development-secret-do-not-use-in-production
# IMPORTANT: Must be at least 32 characters in staging/production!
# IMPORTANT: Cannot contain "development" or "do-not-use" in production!
JWT_ISSUER=ciris-registry

# mTLS Configuration (optional)
MTLS_ENABLED=false
# TLS_CERT_PATH=/path/to/server.crt
# TLS_KEY_PATH=/path/to/server.key
# CA_CERT_PATH=/path/to/ca.crt

# =============================================================================
# Cryptographic Key Configuration
# =============================================================================
KEY_STORAGE_MODE=memory
# Options:
#   memory - Generate ephemeral keys (development only!)
#   file   - Load keys from filesystem
#   vault  - Load keys from HashiCorp Vault (not yet implemented)
#   hsm    - Use hardware security module via PKCS#11 (not yet implemented)

# Required for KEY_STORAGE_MODE=file
# ED25519_KEY_PATH=/path/to/ed25519.key
# MLDSA_KEY_PATH=/path/to/mldsa65.key

# Required for KEY_STORAGE_MODE=vault
# VAULT_ADDR=https://vault.example.com:8200

# =============================================================================
# Logging Configuration
# =============================================================================
RUST_LOG=info,ciris_registry=debug
# Format: level,target=level,target=level
# Levels: trace, debug, info, warn, error

# =============================================================================
# Docker Compose Override (if using docker-compose.yml)
# =============================================================================
# These are used by docker-compose.yml when starting containers:
# POSTGRES_USER=ciris
# POSTGRES_PASSWORD=ciris_dev
# POSTGRES_DB=ciris_registry
